{
  "name": "@mythosia/officeweaver",
  "version": "0.2.0",
  "description": "AI-friendly office automation runtime with traced ONLYOFFICE spreadsheet and word helpers plus bundled RAG-ready manuals.",
  "type": "commonjs",
  "main": "src/officeweaver.js",
  "types": "src/officeweaver.d.ts",
  "exports": {
    ".": {
      "types": "./src/officeweaver.d.ts",
      "require": "./src/officeweaver.js",
      "default": "./src/officeweaver.js"
    },
    "./manuals/*": "./manuals/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check src/officeweaver.js && node --check test/officeweaver.test.js",
    "test": "node test/officeweaver.test.js",
    "prepack": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ-comp/OfficeWeaver.git"
  },
  "bugs": {
    "url": "https://github.com/AJ-comp/OfficeWeaver/issues"
  },
  "homepage": "https://github.com/AJ-comp/OfficeWeaver#readme",
  "license": "MIT",
  "keywords": [
    "onlyoffice",
    "office",
    "spreadsheet",
    "word",
    "document",
    "macro",
    "llm",
    "ai",
    "manuals",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "manuals",
    "README*.md",
    "CHANGELOG.md"
  ]
}
